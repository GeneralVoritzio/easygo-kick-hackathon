# No real backend exists for this prototype yet, so mock mode is on by
# default. Set to false and VITE_WS_URL to a real endpoint once one exists.
# Can also be forced per-tab with ?mock=1 or ?mock=0 in the URL regardless
# of this flag.
VITE_USE_MOCK=true

# Backend WebSocket endpoint for live score updates, once one exists.
VITE_WS_URL=ws://localhost:8080/ws
