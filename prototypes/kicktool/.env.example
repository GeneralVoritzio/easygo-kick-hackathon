# Kick app credentials — https://kick.com/settings/developer
KICK_CLIENT_ID=your_client_id_here
KICK_CLIENT_SECRET=your_client_secret_here

# Public URL of this server (your Tailscale Funnel hostname), no trailing slash.
# The OAuth redirect and webhook URLs are derived from it:
#   redirect URI  -> PUBLIC_URL/auth/callback   (register this on your Kick app)
#   webhook URL   -> PUBLIC_URL/webhooks/kick    (set this on your Kick app)
PUBLIC_URL=

PORT=3000

# Scopes, comma-separated. events:subscribe is required for chat webhooks.
KICK_SCOPES=user:read,channel:read,chat:write,events:subscribe

# Echo bot: replies "Echo: <message>" to each incoming chat message unless ECHO=false.
# BOT_USERNAME is the loop guard — the bot never echoes its own messages.
ECHO=true
BOT_USERNAME=Martibot

# OBS overlay secret key. Optional — leave blank to auto-generate and persist
# to overlay-key.json (the OBS URL stays stable across restarts). Set it to pin
# your own value. Overlay URL: PUBLIC_URL/overlay?key=<this>
OVERLAY_KEY=

# Log verbosity: debug | info | warn | error (default info). CHAT/EVENT always show.
LOG_LEVEL=info
